{
  "name": "linepay-v4",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript SDK for the LINE Pay Online API v4 — correct signing, lossless 19-digit transaction IDs, unknown-outcome aware errors.",
  "keywords": [
    "linepay",
    "line-pay",
    "line",
    "payment",
    "online-api-v4",
    "taiwan",
    "thailand",
    "sdk"
  ],
  "homepage": "https://github.com/jianan1104/linepay-v4#readme",
  "bugs": {
    "url": "https://github.com/jianan1104/linepay-v4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianan1104/linepay-v4.git"
  },
  "license": "MIT",
  "author": "林建安 <linjianan1104@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run build && npm run lint:package",
    "test:sandbox": "node --env-file-if-exists=.env.sandbox ./node_modules/vitest/vitest.mjs run tests/sandbox.test.ts",
    "sandbox:flow": "node --env-file-if-exists=.env.sandbox --experimental-strip-types scripts/sandbox-flow.ts",
    "coverage": "vitest run --coverage",
    "lint:package": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
